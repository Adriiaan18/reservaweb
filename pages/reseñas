<?php
/*
 |--------------------------------------------------------------------------
 | PÁGINA PÚBLICA: RESEÑAS
 |--------------------------------------------------------------------------
 | - Muestra todas las reseñas (más recientes primero)
 | - Si el usuario está logeado muestra un formulario para dejar reseña
 | - Usa htmlspecialchars() al mostrar texto para evitar XSS
 */

include '../includes/header.php';
require '../includes/db.php';

// Obtener reseñas (las más recientes primero) y nombre del usuario
$stmt = $pdo->query("
    SELECT r.*, u.nombre
    FROM resenas r
    JOIN usuarios u ON r.usuario_id = u.id
    ORDER BY r.fecha DESC
");
$resenas = $stmt->fetchAll();

// Calcular valoración media (opcional, para mostrar en la cabecera)
$avgStmt = $pdo->query("SELECT AVG(puntuacion) as media, COUNT(*) as total FROM resenas");
$ag = $avgStmt->fetch();
$media = $ag['media'] ? round($ag['media'], 2) : 0;
$totalResenas = $ag['total'];
?>

<h2>Reseñas de clientes</h2>

<!-- Mostrar valoración media -->
<p>Valoración media: <strong><?= htmlspecialchars($media) ?></strong> / 5 (<?= $totalResenas ?> reseñas)</p>

<!-- LISTADO DE RESEÑAS -->
<div class="lista-resenas">
<?php if (empty($resenas)): ?>
    <p>Aún no hay reseñas. ¡Sé el primero en dejar una!</p>
<?php else: ?>
    <?php foreach ($resenas as $r): ?>
        <div class="resena-item">
            <p><strong><?= htmlspecialchars($r['nombre']); ?></strong>
               — <small><?= htmlspecialchars($r['fecha']); ?></small>
            </p>
            <p>
                <!-- Mostrar estrellas -->
                <?php
                    $p = (int)$r['puntuacion'];
                    for ($i = 1; $i <= 5; $i++) {
                        echo $i <= $p ? "★" : "☆";
                    }
                ?>
            </p>
            <p><?= nl2br(htmlspecialchars($r['comentario'])); ?></p>
        </div>
        <hr>
    <?php endforeach; ?>
<?php endif; ?>
</div>

<!-- FORMULARIO PARA AÑADIR RESEÑA (solo usuarios logeados) -->
<?php if (!empty($_SESSION['user'])): ?>
    <h3>Deja tu reseña</h3>

    <!-- Mostrar mensajes de éxito/error si vienen por GET -->
    <?php if (!empty($_GET['ok'])): ?>
        <p style="color:green;">¡Gracias! Tu reseña se ha publicado.</p>
    <?php endif; ?>
    <?php if (!empty($_GET['error'])): ?>
        <p style="color:red;"><?= htmlspecialchars($_GET['error']) ?></p>
    <?php endif; ?>

    <form action="procesar_resena.php" method="POST">
        <label>Valoración:</label>
        <select name="puntuacion" required>
            <option value="">-- Elige --</option>
            <option value="5">5 - Excelente</option>
            <option value="4">4 - Muy bien</option>
            <option value="3">3 - Bien</option>
            <option value="2">2 - Regular</option>
            <option value="1">1 - Mal</option>
        </select>

        <label>Comentario (opcional):</label>
        <textarea name="comentario" rows="4" placeholder="Escribe tu opinión..."></textarea>

        <button type="submit">Enviar reseña</button>
    </form>

<?php else: ?>
    <p>Para dejar una reseña debes <a href="/reservaweb/login.php">iniciar sesión</a>.</p>
<?php endif; ?>

<?php include '../includes/footer.php'; ?>
